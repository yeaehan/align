process {
    executor = "local"
    cpus = 4
    memory = "16 GB"
    time = "24h"

    withLabel: bucket_upload {
        cpus = 1
        memory = "4 GB"
        time = "6h"
        errorStrategy = "retry"
        maxRetries = 3
    }
}

docker.enabled = false

timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true

profiles {
    local {
        process {
            executor = "local"
            maxForks = 1
        }
    }

    // Recommended starting profile for GPU-enabled 2D alignment.
    // The code currently uses only one GPU, so do not request a four-GPU node.
    mayo_gpu {
        process {
            executor = "slurm"
            queue = "gpu-n12-85g-1x-a100-40g"
            cpus = 12
            memory = "80 GB"
            time = "24h"

            errorStrategy = { task.exitStatus in [137, 143] ? "retry" : "terminate" }
            maxRetries = 2

            withName: ALIGN_IMAGES {
                clusterOptions = "--gres=gpu:1"
            }

            withLabel: bucket_upload {
                queue = "sm-n2-8g"
                cpus = 1
                memory = "4 GB"
                time = "6h"
                errorStrategy = "retry"
                maxRetries = 3
            }
        }

        executor {
            queueSize = 10
            submitRateLimit = "3/sec"
        }

        params {
            cpus = 12
            no_gpu = false
            bucket = "gs://ml-phi-arch-rsa-us-central1-p-4591/align"
        }
    }

    // Use for large inputs, 3D work, or when CuPy/CUDA is unavailable.
    mayo_cpu_large {
        process {
            executor = "slurm"
            queue = "lg-n64-256g"
            cpus = 16
            memory = "240 GB"
            time = "24h"

            errorStrategy = { task.exitStatus in [137, 143] ? "retry" : "terminate" }
            maxRetries = 2

            withLabel: bucket_upload {
                queue = "sm-n2-8g"
                cpus = 1
                memory = "4 GB"
                time = "6h"
                errorStrategy = "retry"
                maxRetries = 3
            }
        }

        executor {
            queueSize = 10
            submitRateLimit = "3/sec"
        }

        params {
            cpus = 16
            no_gpu = true
            bucket = "gs://ml-phi-arch-rsa-us-central1-p-4591/align"
        }
    }

    // Escalation profile for the current memory-heavy z-stack implementation.
    mayo_cpu_huge {
        process {
            executor = "slurm"
            queue = "huge-n128-512g"
            cpus = 16
            memory = "480 GB"
            time = "24h"

            errorStrategy = { task.exitStatus in [137, 143] ? "retry" : "terminate" }
            maxRetries = 2

            withLabel: bucket_upload {
                queue = "sm-n2-8g"
                cpus = 1
                memory = "4 GB"
                time = "6h"
                errorStrategy = "retry"
                maxRetries = 3
            }
        }

        executor {
            queueSize = 5
            submitRateLimit = "2/sec"
        }

        params {
            cpus = 16
            no_gpu = true
            bucket = "gs://ml-phi-arch-rsa-us-central1-p-4591/align"
        }
    }
}
